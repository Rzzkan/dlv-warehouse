# /etc/systemd/system/dlv-warehouse.service
[Unit]
Description=Delova Gudang (wh.delova.id)
After=network.target mysql.service mariadb.service
Wants=mysql.service

[Service]
Type=simple
User=delova
WorkingDirectory=/opt/dlv-warehouse
EnvironmentFile=/opt/dlv-warehouse/.env
ExecStart=/usr/bin/node server/index.js
Restart=always
RestartSec=3
# Pengamanan dasar
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
