# Salin menjadi .env lalu sesuaikan
PORT=3000
HOST=0.0.0.0

# --- MySQL / MariaDB ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=delova
DB_PASSWORD=ganti-password-ini
DB_NAME=delova_warehouse
DB_POOL_SIZE=10
# 1 = buat database (CREATE DATABASE IF NOT EXISTS) otomatis bila user DB punya izin. Set 0 bila database sudah disiapkan DBA.
DB_AUTO_CREATE=1

# Password admin awal (hanya dipakai saat database masih kosong). Kosong = "admin123" + wajib ganti.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# WIB = 420 (menit dari UTC)
TZ_OFFSET_MINUTES=420
# Set 1 bila diakses lewat HTTPS
COOKIE_SECURE=0
SESSION_DAYS=14
