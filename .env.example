# Salin menjadi .env lalu sesuaikan
PORT=3000
HOST=0.0.0.0
DB_FILE=data/warehouse.db
# Password admin awal (hanya dipakai saat database masih kosong). Kosong = "admin123" + wajib ganti.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# WIB = 420 (menit dari UTC)
TZ_OFFSET_MINUTES=420
# Set 1 bila diakses lewat HTTPS
COOKIE_SECURE=0
SESSION_DAYS=14
