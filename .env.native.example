# Salin ke /opt/dlv-warehouse/.env (tanpa Docker). GANTI semua password.
PORT=3000
HOST=127.0.0.1            # hanya proxy di mesin yang sama yang boleh mengakses
TRUST_PROXY=loopback
COOKIE_SECURE=1

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=delova
DB_PASSWORD=ganti-password-db-panjang
DB_NAME=delova_warehouse
DB_AUTO_CREATE=0

ADMIN_USERNAME=admin
ADMIN_PASSWORD=ganti-password-admin-awal
TZ_OFFSET_MINUTES=420
SESSION_DAYS=14
