# Salin menjadi .env di server, lalu GANTI semua password.
# File compose yang dipakai oleh semua perintah `docker compose` & skrip backup di folder ini
COMPOSE_FILE=docker-compose.prod.yml
APP_DOMAIN=wh.delova.id

DB_ROOT_PASSWORD=ganti-root-password-panjang
DB_USER=delova
DB_PASSWORD=ganti-password-db-panjang
DB_NAME=delova_warehouse

# Dipakai hanya saat database masih kosong (pertama kali jalan)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ganti-password-admin-awal

TZ_OFFSET_MINUTES=420
SESSION_DAYS=14
